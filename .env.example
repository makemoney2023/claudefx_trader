# ICT Trading Bot Environment Variables
# Copy this file to .env.local and fill in your credentials

# MetaTrader 5 Configuration (Windows only - Mac uses simulation mode)
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YOUR-BROKER-SERVER
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Claude API Configuration (REQUIRED for AI analysis)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Trading Configuration
# Only USD-quoted pairs - NEVER include BTC/BIT-quoted pairs (ETHBTC, DASHBTC, etc.)
TRADING_SYMBOLS=["EURUSD", "GBPUSD", "XAUUSD", "XAGUSD", "BTCUSD", "ETHUSD", "XRPUSD", "ADAUSD", "SOLUSD"]
TRADING_RISK_PER_TRADE=0.02
TRADING_MAX_DAILY_TRADES=3
TRADING_MIN_RISK_REWARD=1.0
TRADING_ALLOWED_SESSIONS=["all"]
TRADING_ALLOW_SIMULATION_TRADES=false
TRADING_MAX_POSITION_SIZE=1.0
TRADING_MAX_TOTAL_EXPOSURE=5.0
TRADING_MAX_DAILY_DRAWDOWN=0.03
TRADING_MAX_WEEKLY_DRAWDOWN=0.06
# Bot does NOT auto-start on API launch by default — start manually from dashboard
TRADING_AUTO_START_BOT=false
# Only enable on demo accounts explicitly collecting training data (AGGRESSIVE mode)
TRADING_DEMO_DATA_COLLECTION=false

# Telegram Notifications (optional)
# Create a bot via @BotFather, get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firecrawl Market Intelligence (optional)
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=true

# API authentication for mutating/expensive dashboard routes (REQUIRED in production)
BOT_API_KEY=generate-a-long-random-secret

# ICT session enforcement: when true, trades outside configured kill zones are blocked
STRICT_ICT_SESSIONS=false

# CORS Configuration (for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
