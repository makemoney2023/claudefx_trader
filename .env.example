# ICT Trading Bot Environment Variables
# Copy this file to .env.local and fill in your credentials

# MetaTrader 5 Configuration (Windows only - Mac uses simulation mode)
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YOUR-BROKER-SERVER
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Claude API Configuration (REQUIRED for AI analysis)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Trading Configuration
# Only USD-quoted pairs - NEVER include BTC/BIT-quoted pairs (ETHBTC, DASHBTC, etc.)
TRADING_SYMBOLS=["EURUSD", "GBPUSD", "XAUUSD", "XAGUSD", "BTCUSD", "ETHUSD", "XRPUSD", "ADAUSD", "SOLUSD"]
TRADING_RISK_PER_TRADE=0.02
TRADING_MAX_DAILY_TRADES=3
TRADING_MIN_RISK_REWARD=1.0
TRADING_ALLOWED_SESSIONS=["all"]
# Hard-skip Claude outside ICT kill zones (used only when ANALYSIS_WINDOW=all_kill_zones)
TRADING_CLAUDE_KILL_ZONE_ONLY=true
# Claude spend window: ny_open = 30min before NY open through NY KZ end (6:30–10:00 ET).
# Rollback: all_kill_zones (London + NY + London Close). Scanner auto-runs on ny_open.
TRADING_CLAUDE_ANALYSIS_WINDOW=ny_open
TRADING_CLAUDE_NY_LEAD_MINUTES=30
TRADING_ALLOW_SIMULATION_TRADES=false
TRADING_MAX_POSITION_SIZE=1.0
TRADING_MAX_TOTAL_EXPOSURE=5.0
TRADING_MAX_DAILY_DRAWDOWN=0.03
TRADING_MAX_WEEKLY_DRAWDOWN=0.06
# Bot does NOT auto-start on API launch by default — start manually from dashboard
TRADING_AUTO_START_BOT=false
# Only enable on demo accounts explicitly collecting training data (AGGRESSIVE mode)
# Pydantic binds TRADING_DEMO_DATA_COLLECTION_MODE (Telegram /toggle demo uses that key).
TRADING_DEMO_DATA_COLLECTION=false
TRADING_DEMO_DATA_COLLECTION_MODE=false
# Telegram /mode lock: conservative|normal|aggressive. Empty = auto (cycle decides).
TRADING_TELEGRAM_MODE_LOCK=

# Telegram Notifications (optional — trade alerts + /commands)
# 1. Create bot via @BotFather  2. Get chat ID from @userinfobot  3. Send /start to your bot
# Test with: python test_telegram_connection.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Windows VPS with antivirus HTTPS scanning often needs this (self-signed cert in chain):
# TELEGRAM_SSL_VERIFY=false

# Firecrawl Market Intelligence (optional)
FIRECRAWL_API_KEY=
FIRECRAWL_ENABLED=true

# API authentication for mutating/expensive dashboard routes (REQUIRED in production)
BOT_API_KEY=generate-a-long-random-secret

# ICT session enforcement: when true, trades outside configured kill zones are blocked
STRICT_ICT_SESSIONS=false

# News blackout + stale-calendar fail-closed. Set false for paper testing when
# Firecrawl/calendar feed is unavailable (re-enable for live).
TRADING_NEWS_GATES_ENABLED=true

# Claude signal trust (wide): soft-pass strategy gates when Claude emits long/short.
# Safety (R:R, spread, FINAL-RISK, daily limits, flip/CB, REJECT) stays hard.
# Config default is off — set active on VPS when deploying trust.
TRADING_CLAUDE_SIGNAL_TRUST_MODE=off
# ICT family confirmation (default disabled — pair with trust for Claude emits)
TRADING_ICT_CONFIRMATION_MODE=disabled
# Optional SB lean (sweep-fade specific); independent of trust
TRADING_LIQUIDITY_REVERSAL_LEAN_MODE=off

# CORS Configuration (for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
